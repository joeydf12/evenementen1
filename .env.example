# Voorbeeld environment variables — niet in git zetten met echte waarden.
# Gebruik op Vercel: Project -> Settings -> Environment Variables

# Basis API-url (client-side; moet prefix VITE_ hebben)
VITE_API_URL=https://api.example.com

# Voorbeeld: analytics id of andere client-side keys
VITE_ANALYTICS_ID=your_analytics_id

# Server-only geheimen (NIET prefixen met VITE_ als je niet wilt dat ze in de client bundel verschijnen)
# EXAMPLE_SERVER_SECRET=replace_with_real_secret
